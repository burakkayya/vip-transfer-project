{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API (hata ayıklama)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "justMyCode": true
    },
    {
      "name": "Backend testleri (hata ayıklama)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "-x"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
    }
  ]
}
