# Kopyalayıp .env olarak kaydedin. Tüm değişkenler GETAWAY_ önekiyle okunur.
GETAWAY_ENV=dev
GETAWAY_DATABASE_URL=postgresql+psycopg://getaway:getaway@localhost:5432/getaway
GETAWAY_REDIS_URL=redis://localhost:6379/0

# Üretimde mutlaka değiştirin. Fernet anahtarı üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Birden fazla anahtar virgülle verilirse ilki şifreler, hepsi çözer (anahtar rotasyonu).
# Geliştirmede boş bırakın (yorum satırı): yerleşik geliştirme anahtarları kullanılır.
# GETAWAY_JWT_SECRET=
# GETAWAY_FIELD_ENCRYPTION_KEYS=
# GETAWAY_BLIND_INDEX_KEY=

# console | netgsm | verimor
GETAWAY_SMS_PROVIDER=console
# Haritayla ilgili her şey Google (K-58). haversine/fake yalnızca otomatik testlerde (GETAWAY_ENV=test).
GETAWAY_ROUTING_PROVIDER=google
# Routes için ayrı anahtar yoksa GOOGLE_MAPS_API_KEY kullanılır.
GETAWAY_GOOGLE_ROUTES_API_KEY=

# Adres arama: google (Places API New). Anahtar zorunlu, yoksa sunucu açılmaz.
GETAWAY_PLACES_PROVIDER=google
# Places API (New) ve Routes API açık, sunucu IP'si ile kısıtlı anahtar. İstemciye verilmez.
GETAWAY_GOOGLE_MAPS_API_KEY=

# fake | paytr
GETAWAY_PAYMENT_PROVIDER=fake
GETAWAY_PAYTR_MERCHANT_ID=
GETAWAY_PAYTR_MERCHANT_KEY=
GETAWAY_PAYTR_MERCHANT_SALT=
GETAWAY_PAYTR_TEST_MODE=true

# K-15: hukuki teyit gelene kadar kapalı kalmalı.
GETAWAY_GUARANTEE_ENABLED=false

# Mobil bildirim: console (geliştirme) veya fcm. fcm için servis hesabı JSON yolu (repo dışında).
GETAWAY_PUSH_PROVIDER=console
GETAWAY_FCM_CREDENTIALS_FILE=
