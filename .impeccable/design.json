  "narrative": {
    "northStar": "Kıyı Yolu",
    "overview": "Havalimanından otele uzanan Akdeniz kıyı yolu: yolcu indiği andan kapıya varana kadar tek, kesintisiz bir hat üzerindedir. Sistem bu hattı görünür kılar. Rota rayı (nokta, kesikli çizgi, kare), gerçek kıyı ve araç fotoğrafları ve yolculuğun bir sonraki adımını işaret eden hareket bu dünyanın taşıyıcılarıdır. Zemin lake siyah ve kâğıt beyazıdır; şampanya pirinci yalnızca yolun özel anlarında parlar.\n\nMüşteri web sitesi bu yolu cesurca anlatır (Persuade): kenardan kenara fotoğraf, iri ve sıkı Inter başlıklar, belirgin biçimde yükselen kartlar, kaydırmaya bağlı hareket. Rezervasyon, ödeme ve hesap ekranlarında (Operate) yol sakinleşir: aynı malzemeler, daha az hareket, tek bir sonraki adım. Admin paneli aynı ailedendir ama bir işletme masasıdır: yoğun, hizalı, sessiz; marka yalnızca hassas ayrıntılarda yaşar.",
    "keyCharacteristics": [
      "Lake siyah ve kâğıt beyazı zıtlığı; renk değil kontrast taşır.",
      "Rota rayı imzası: alış noktası daire, varış kare, arada kesikli çizgi.",
      "Gerçek fotoğraf (kıyı yolu, Vito, V-Class, Sprinter); illüstrasyon yok.",
      "Belirgin yükselti: elde tutulan öğeler (rota kartı, özet, alt panel) gölgeyle öne çıkar.",
      "Şampanya pirinci nadirdir ve anlamlıdır."
    ],
    "rules": [
      {
        "name": "The Brass Is Rare Rule",
        "body": "Şampanya pirinci bir ekranın %10'unu geçmez ve yalnızca \"özel\" anlarda görünür (VIP, teklif, seçili durum). Birincil eylem her zaman lake siyahtır.",
        "section": "colors"
      },
      {
        "name": "The Text Floor Rule",
        "body": "Metin rengi, zemininde 4,5:1'in altına düşmez. Yer tutucu metin dahil hiçbir metin `slate-faint`'ten açık olamaz.",
        "section": "colors"
      },
      {
        "name": "The Status Means Status Rule",
        "body": "Kırmızı, yeşil ve kehribar yalnızca durum bildirir; süs olarak kullanılmaz.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Tüm yüzeylerde yalnızca Inter. Vurgu ağırlık ve ölçekle yapılır, ikinci bir yazı tipiyle değil.",
        "section": "typography"
      },
      {
        "name": "The Tabular Money Rule",
        "body": "Tutarlar, saatler ve kodlar tabular rakamla (`font-variant-numeric: tabular-nums`) yazılır; tablolarda sağa hizalanır.",
        "section": "typography"
      },
      {
        "name": "The Held Object Rule",
        "body": "Gölge yalnızca kullanıcının etkileşimde olduğu veya elinde tuttuğu öğede bulunur. Bir ekranda en fazla iki \"yüzen\" öğe olur.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do birincil eylemi her ekranda tek ve lake siyah tut.",
      "Do fiyatı yalnızca backend'den geldiği haliyle, para birimi biçimiyle (`Intl.NumberFormat`) göster.",
      "Do her yükleniyor, boş ve hata durumunu görünür yap; iskelet, yükleme bekleyen fiyatın yerini korur.",
      "Do mantıksal CSS özellikleri kullan; düzen Almanca uzunluğunda ve `dir=\"rtl\"` altında kırılmamalı.",
      "Do her animasyonu `prefers-reduced-motion` altında kapat veya anlık geçişe indir."
    ],
    "donts": [
      "Don't şampanya pirincini birincil düğme, büyük yüzey ya da beyaz zeminde küçük metin rengi olarak kullanma (küçük metinde `champagne-brass-ink`).",
      "Don't `slate-faint`'ten açık gri metin kullanma.",
      "Don't önceden işaretli onay kutusu veya reddi gizleyen rıza deseni kullanma; KVKK aydınlatma, açık rıza ve pazarlama onayı ayrı kalır.",
      "Don't doğrulanmamış güven kanıtı (yorum, puan, sayı, logo) ekleme.",
      "Don't admin'e pazarlama hareketi veya dekoratif gölge ekleme."
    ]
  }
}
