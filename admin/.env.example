# Backend adresi (yalnızca sunucu tarafı)
GETAWAY_API_URL=http://localhost:8000

# İstemci IP zinciri (REV-A-3, docs/security/client-ip.md). İstemcinin yazdığı IP başlıkları aktarılmaz.
# cloudflare: yalnızca cf-connecting-ip (BFF'ye yalnızca Cloudflare erişebiliyorsa)
# xff: x-forwarded-for'un sağdan BFF_TRUSTED_HOPS'uncu değeri (BFF önündeki güvenilir proxy sayısı)
# none / boş: IP aktarılmaz (geliştirme varsayılanı)
BFF_CLIENT_IP_SOURCE=none
BFF_TRUSTED_HOPS=1

# CSRF köken listesi (WEB-03, lib/bffGuard.ts). Durum değiştiren /bff isteklerinde Origin bu listeyle tam
# eşleşmeli (şema + ana makine + port; virgülle ayrılır, ör. https://admin.getawaytransfers.com).
# Host / X-Forwarded-Host başlıklarına bakılmaz.
# - Tanımsız + geliştirme (next dev): yalnızca http://localhost:*, http://127.0.0.1:*, http://[::1]:* kabul edilir.
# - Tanımsız + üretim (NODE_ENV=production, next start dahil): HİÇBİR köken kabul edilmez, tüm POST/PATCH/DELETE 403.
#   Yerelde `npm run start` ile denerken .env.local içine ör. ALLOWED_ORIGINS=http://localhost:3001 yazın.
# - LAN'dan (telefon) deneme: ALLOWED_ORIGINS=http://<makine-ip>:3001
ALLOWED_ORIGINS=

# Oturum çerezlerinde Secure bayrağı ve __Secure- öneki (WEB-08, lib/bffCookies.ts). Üretimde (NODE_ENV=production)
# her zaman açıktır. HTTPS arkasında `next dev` ile koşan bir staging için 1 yapın. Yerel http geliştirmede boş bırakın.
BFF_SECURE_COOKIES=
