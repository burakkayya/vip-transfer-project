  "narrative": {
    "northStar": "Kıyı Yolu",
    "overview": "Telefonda yol bir haritadır. Üstte harita, altta elde tutulan bir panel; panel yolun o anki adımını taşır: nereye, hangi araç, sürücü nerede. Sistem web ile aynı malzemeden yapılır (lake siyah, kâğıt, tek pirinç vurgu, gerçek araç fotoğrafı) ama dokunma için ölçeklenir.\n\nİki uygulama aynı dünyayı farklı yoğunlukta konuşur. Müşteri uygulaması dokunsal ve kendinden emindir: iri başlık, dolgun düğme, yumuşak hareket, haptik geri bildirim. Sürücü uygulaması bir pano gibidir: tek bakışta okunur, iri hedefli, güneş altında yüksek kontrastlı; teklif kartı ve karşılama tabelası onun imzasıdır.",
    "keyCharacteristics": [
      "Harita + alt panel düzeni (`MapSheet`), panel yükselir ve sürüklenir.",
      "Lake siyah birincil eylem, 56 px yükseklik, başparmak alanında alt çubukta.",
      "Rota rayı web ile aynı: daire, kesikli çizgi, kare.",
      "Sürücüde iri ve az: GO düğmesi, geri sayım halkalı teklif kartı, tam ekran tabela."
    ],
    "rules": [
      {
        "name": "The Sunlight Rule",
        "body": "Sürücü uygulamasında hiçbir metin veya simge 4,5:1'in altına düşmez; birincil bilgi (tutar, adres, geri sayım) 7:1'i hedefler.",
        "section": "colors"
      },
      {
        "name": "The Dynamic Type Rule",
        "body": "Metin sistem yazı boyutuyla büyür; düzen %200'de kırılmaz, kritik etiketler kesilmez (`numberOfLines` yalnızca ikincil metinde).",
        "section": "typography"
      }
    ],
    "dos": [
      "Do birincil eylemi alt çubukta, başparmak alanında tut.",
      "Do sürücü uygulamasında tüm dokunma hedeflerini en az 48 dp yap.",
      "Do her Reanimated animasyonunda sistem \"hareketi azalt\" ayarına uy (`ReduceMotion.System`, döngülerde `useReducedMotion`).",
      "Do her eyleme `accessibilityRole` ve `accessibilityLabel` ver.",
      "Do bağlantı yokken ve konum gelmezken bunu açıkça yaz; eski veriyi canlıymış gibi gösterme."
    ],
    "donts": [
      "Don't `#A1A1A6` gibi 4,5:1'in altındaki grileri metin rengi olarak kullanma.",
      "Don't beyaz zeminde küçük metni şampanya pirinciyle yazma.",
      "Don't fiyatı istemcide hesaplama veya yuvarlama; backend tutarını göster.",
      "Don't sürücü ekranında uzun paragraf veya ikinci bir birincil eylem koyma.",
      "Don't önceden işaretli onay kutusu kullanma."
    ]
  }
}
