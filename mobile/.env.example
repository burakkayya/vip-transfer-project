# Yerelde `mobile/.env.local` olarak kopyalayın; değerler repoya yazılmaz.
# Android Google Maps SDK anahtarı (paket adı + SHA-1 kısıtlı), yalnızca native derleme.
GETAWAY_GOOGLE_MAPS_ANDROID_KEY=
# iOS Google Maps SDK anahtarı (isteğe bağlı; yoksa Apple Maps).
GETAWAY_GOOGLE_MAPS_IOS_KEY=
# Web önizlemesi (8081/8082) gerçek harita: web sitesinin referrer kısıtlı tarayıcı anahtarı
# (NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY ile aynı). Boşsa stilize SVG harita gösterilir.
EXPO_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Firebase google-services.json yolu (repo dışında; iki paketi de içeren dosya). Boşsa push jetonu alınmaz.
GETAWAY_GOOGLE_SERVICES_FILE=
