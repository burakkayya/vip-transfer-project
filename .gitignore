# --- Python (backend) ---
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
htmlcov/

# --- Node / Next.js (web, admin) ---
node_modules/
scripts/ui-shots/node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo

# --- Expo (mobile) ---
.expo/
.expo-shared/
dist/
web-build/
mobile/.export-check/
mobile/android/
mobile/ios/

# --- Ortam ve gizli bilgiler (asla commit edilmez) ---
# Her dizinde geçerli (eğik çizgisiz desen). Yalnızca değer içermeyen şablonlar (.env.example) izlenir.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# INF-12: Firebase/FCM, Google ve mağaza imza kimlik dosyaları. Bu dosyalar EAS/CI gizli değişkeninden
# (dosya tipi secret) üretilir, depoya girmez. İstisna gerekirse dosya adıyla tek tek `!` satırı eklenir.
google-services.json
GoogleService-Info.plist
*firebase-adminsdk*.json
*serviceAccount*.json
*service-account*.json
*service_account*.json
fcm-sa*.json
credentials.json
client_secret*.json
# Apple APNs/App Store Connect anahtarı (.p8), sertifika paketleri ve Android imza depoları.
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
# EAS yerel imza bilgisi klasörü (eas credentials yerel kopyası).
credentials/
# SSH ve paket kayıt kimlikleri. Gizli değer içermeyen bir .npmrc gerekirse `git add -f` ile bilinçli eklenir.
id_rsa*
id_ed25519*
id_ecdsa*
.npmrc
.pypirc
.netrc
# Terraform/diğer araçların yerel durum ve değişken dosyaları gizli değer içerebilir.
*.tfvars
!*.tfvars.example

# --- Çalışma verisi ve günlükler ---
backend/var/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Editör ve yerel ayarlar ---
.claude/settings.local.json
# Impeccable: ikili dosya ilk çalışmada indirilir; kişisel ayar ve oturum verisi yereldir.
.claude/skills/impeccable/scripts/bin/
.impeccable/config.local.json
.impeccable/live/
.impeccable/critique/
.idea/
*.swp
.DS_Store
Thumbs.db
*.stackdump

# --- Playwright çıktıları ---
web/test-results/
web/playwright-report/
admin/test-results/
admin/playwright-report/
admin/e2e/.auth/

# Reklam ekran görüntüleri (scripts/ui-shots/promo-web.js, iOS yapıtı); büyük PNG, repoya girmez
reklam-gorselleri/
